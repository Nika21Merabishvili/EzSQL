# ── Django ────────────────────────────────────────────────────────────────────
# Generate a real key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# ── Google OAuth (phase 1 auth) ────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/ → APIs & Services → Credentials
# Application type: Web application
# See README.md → "Google OAuth Setup" for the full walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Database (optional — defaults to SQLite) ───────────────────────────────────
# DATABASE_URL=postgres://user:password@localhost:5432/ezsql

# ── Sandbox DB path (optional — defaults to backend/sandbox.db) ───────────────
# SANDBOX_DB_PATH=/absolute/path/to/sandbox.db

# ── Frontend (optional — leave empty in dev; Vite proxy routes to Django) ──────
# VITE_API_BASE=https://api.yourdomain.com
